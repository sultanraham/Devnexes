# ═══════════════════════════════════════════════════════════════
# ENVIRONMENT VARIABLES TEMPLATE — copy this to .env and fill values
# NEVER commit .env to git — it is in .gitignore
# ═══════════════════════════════════════════════════════════════

# ── FRONTEND (Vite injects these into browser bundle at build time) ──
# SAFE to expose: these are public-facing values only
VITE_API_URL=http://127.0.0.1:5001
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── SERVER ONLY (never use VITE_ prefix for these — that would expose them!) ──
# Supabase service role key — full database access, keep this PRIVATE
SUPABASE_SERVICE_KEY=your-service-role-key-here

# JWT signing secret — use a long random string (min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate-a-long-random-secret-here

# Allowed CORS origin for the Express server
CLIENT_URL=http://localhost:5173
